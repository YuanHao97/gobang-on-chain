DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
AI_RECOMMENDER_HOST=127.0.0.1
AI_RECOMMENDER_PORT=8790
AI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AI_REQUESTS_PER_MINUTE=10
# Keep the Ethereum Sepolia settings for old clients and existing games.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example/v1/your-key
RELAYER_PRIVATE_KEY=0xyour_test_relayer_private_key
GAME_MANAGER_ADDRESS=0xyour_game_manager_address
# Set this after the relay mints its reusable computer chess piece.
ROBOT_PIECE_ID=
RELAY_CHAIN_ID=11155111
# Add Base alongside Ethereum. The relay key above is reused unless overridden.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_GAME_MANAGER_ADDRESS=
BASE_SEPOLIA_ROBOT_PIECE_ID=
# BASE_SEPOLIA_RELAYER_PRIVATE_KEY=0xyour_separate_base_test_relayer_key
RELAY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://yuanhao97.github.io
RELAY_REQUESTS_PER_MINUTE=30
