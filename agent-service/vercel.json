{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/recommend.mjs": {
      "maxDuration": 60
    },
    "api/relay.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/health" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/recommend", "destination": "/api/recommend" },
    { "source": "/relay/activate", "destination": "/api/relay?operation=activate" },
    { "source": "/relay/move", "destination": "/api/relay?operation=move" },
    { "source": "/relay/computer/prepare", "destination": "/api/relay?operation=computerPrepare" },
    { "source": "/relay/computer/join", "destination": "/api/relay?operation=computerJoin" },
    { "source": "/relay/computer/move", "destination": "/api/relay?operation=computerMove" }
  ]
}
